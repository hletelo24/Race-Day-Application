@model front_end_web.Models.Events.EventViewModel
@{
    ViewData["Title"] = "Delete Event";
}
<div class="container py-4">
    <div class="card border-danger shadow-sm">
        <div class="card-body p-4">
            <h1 class="h3 text-danger">Delete Event</h1>
            <p>Are you sure you want to delete <strong>@Model.Title</strong>?</p>
            <dl class="row">
                <dt class="col-sm-3">Date</dt>
                <dd class="col-sm-9">@Model.Date.ToString("dd MMM yyyy")</dd>
                <dt class="col-sm-3">Route</dt>
                <dd class="col-sm-9">Route #@Model.RouteId (@Model.Distance km)</dd>
            </dl>
            <p class="text-muted">The API may reject deletion if enrolments or results depend on this event.</p>
            <form asp-action="DeleteEvent" asp-route-id="@Model.EventId" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-danger">Confirm Delete</button>
                <a asp-action="Events" class="btn btn-outline-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>
