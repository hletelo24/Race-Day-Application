@model List<front_end_web.Models.Organiser.CategoryViewModel>

@{
    ViewData["Title"] = "Manage Categories";
}

<section class="container py-5 category-page">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <span class="category-eyebrow">RACEDAY ORGANISER</span>
            <h1 class="fw-bold mb-2">Manage Categories</h1>
            <p class="text-muted mb-0">
                Create and maintain categories used to organise your races.
            </p>
        </div>

        <a asp-action="CreateCategory" class="btn btn-category-primary">
            <i class="bi bi-plus-lg me-2"></i>Add Category
        </a>
    </div>

    @if (TempData["SuccessMessage"] is string success)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @success
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] is string error)
    {
        <div class="alert alert-warning" role="alert">
            @error
        </div>
    }

    <div class="category-summary mb-4">
        <div class="category-summary-icon">
            <i class="bi bi-tags"></i>
        </div>
        <div>
            <div class="text-muted small">Categories available</div>
            <div class="fs-3 fw-bold">@Model.Count</div>
        </div>
    </div>

    <div class="card category-table-card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h2 class="h5 mb-0">All Categories</h2>
            <span class="text-muted small">Category directory</span>
        </div>

        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col">Category</th>
                        <th scope="col">Description</th>
                        <th scope="col" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="3" class="text-center py-5">
                                <i class="bi bi-tags category-empty-icon"></i>
                                <h3 class="h5 mt-3">No categories yet</h3>
                                <p class="text-muted">
                                    Create your first category to get started.
                                </p>
                                <a asp-action="CreateCategory"
                                   class="btn btn-category-primary">
                                    Add your first category
                                </a>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var category in Model)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="category-title-icon">
                                            <i class="bi bi-tag"></i>
                                        </div>
                                        <div>
                                            <div class="fw-semibold">
                                                @category.Title
                                            </div>
                                            <small class="text-muted">
                                                ID: @category.CategoryId
                                            </small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    @if (string.IsNullOrWhiteSpace(category.Description))
                                    {
                                        <span class="text-muted fst-italic">
                                            No description
                                        </span>
                                    }
                                    else
                                    {
                                        @category.Description
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-2">
                                        <a asp-action="EditCategory"
                                           asp-route-id="@category.CategoryId"
                                           class="btn btn-sm btn-outline-dark"
                                           aria-label="Edit @category.Title">
                                            <i class="bi bi-pencil-square me-md-1"></i>
                                            <span class="d-none d-md-inline">Edit</span>
                                        </a>

                                        <a asp-action="DeleteCategory"
                                           asp-route-id="@category.CategoryId"
                                           class="btn btn-sm btn-outline-danger"
                                           aria-label="Delete @category.Title">
                                            <i class="bi bi-trash me-md-1"></i>
                                            <span class="d-none d-md-inline">Delete</span>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div class="card-footer text-muted small">
            Showing @Model.Count category@(Model.Count == 1 ? "" : "ies").
        </div>
    </div>

    <a asp-action="Dashboard" class="btn btn-link mt-4 text-decoration-none">
        <i class="bi bi-arrow-left me-2"></i>Back to Dashboard
    </a>
</section>