@model IEnumerable<front_end_web.Models.Results.ParticipantRaceResultViewModel>
@{ ViewData["Title"] = "My Race Results"; }
<div class="container py-4">
    <h1 class="h3">My Race Results</h1>
    <p class="text-muted mb-4">Your recorded finish times.</p>
    @if (TempData["ErrorMessage"] is string error) { <div class="alert alert-danger">@error</div> }
    @if (!Model.Any()) {
        <div class="alert alert-info">No results have been recorded for your races yet.</div>
    } else {
        <div class="table-responsive"><table class="table table-striped">
            <thead><tr><th>Event</th><th>Date</th><th>Distance (km)</th><th>Finish time</th></tr></thead>
            <tbody>
            @foreach (var result in Model.OrderBy(x => x.EventDate)) {
                <tr><td>@result.EventName</td><td>@result.EventDate.ToString("dd MMM yyyy")</td><td>@result.Distance.ToString("0.##")</td><td><strong>@result.TimeText</strong></td></tr>
            }
            </tbody>
        </table></div>
    }
</div>
