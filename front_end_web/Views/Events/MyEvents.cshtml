@model IReadOnlyCollection<front_end_web.Models.Events.ParticipantEnrolmentViewModel>

@{
    ViewData["Title"] = "My Events";
    var today = DateTime.Today;
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="h2 mb-1">My Events</h1>
            <p class="text-muted mb-0">Events you have enrolled in.</p>
        </div>
        <a asp-controller="Events" asp-action="Index" class="btn btn-outline-primary">
            Browse events
        </a>
    </div>

    @if (TempData["Error"] is string errorMessage)
    {
        <div class="alert alert-danger" role="alert">@errorMessage</div>
    }
    @if (TempData["Success"] is string successMessage)
    {
        <div class="alert alert-success" role="alert">@successMessage</div>
    }

    @if (Model == null || Model.Count == 0)
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">
                <h2 class="h5">You have not enrolled in any events yet</h2>
                <p class="text-muted">Browse available events and enrol to see them listed here.</p>
                <a asp-controller="Events" asp-action="Index" class="btn btn-primary">Find an event</a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                var hasDate = item.EventDate.HasValue;
                var isUpcoming = hasDate && item.EventDate!.Value.Date >= today;
                <div class="col-12 col-md-6 col-xl-4">
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                <span class="badge @(isUpcoming ? "bg-success" : "bg-secondary")">
                                    @(isUpcoming ? "Upcoming" : "Past event")
                                </span>
                                @if (!string.IsNullOrWhiteSpace(item.CategoryTitle))
                                {
                                    <span class="badge bg-light text-dark">@item.CategoryTitle</span>
                                }
                            </div>

                            <h2 class="h5 card-title">@item.EventTitle</h2>

                            <dl class="row small mb-3">
                                <dt class="col-5">Date</dt>
                                <dd class="col-7">@(hasDate ? item.EventDate!.Value.ToString("dd MMM yyyy") : "Not available")</dd>

                                <dt class="col-5">Start time</dt>
                                <dd class="col-7">@(item.StartTime.HasValue ? item.StartTime.Value.ToString(@"hh\:mm") : "Not available")</dd>

                                <dt class="col-5">Distance</dt>
                                <dd class="col-7">@(item.Distance.HasValue ? $"{item.Distance.Value:0.##} km" : "Not available")</dd>

                                <dt class="col-5">Start</dt>
                                <dd class="col-7">@(string.IsNullOrWhiteSpace(item.StartLocation) ? "Not available" : item.StartLocation)</dd>

                                <dt class="col-5">Finish</dt>
                                <dd class="col-7">@(string.IsNullOrWhiteSpace(item.EndLocation) ? "Not available" : item.EndLocation)</dd>

                                <dt class="col-5">Enrolled on</dt>
                                <dd class="col-7">@item.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</dd>
                            </dl>

                            <div class="mt-auto">
                                <a asp-controller="Events" asp-action="Details" asp-route-id="@item.EventId"
                                   class="btn btn-outline-primary w-100">View event details</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
