@model front_end_web.Models.Profile.ProfileViewModel

@{
    ViewData["Title"] = "My Profile";

    var firstInitial = string.IsNullOrWhiteSpace(Model.FirstName)
        ? "U"
        : Model.FirstName.Substring(0, 1).ToUpper();

    var lastInitial = string.IsNullOrWhiteSpace(Model.LastName)
        ? ""
        : Model.LastName.Substring(0, 1).ToUpper();

    var initials = firstInitial + lastInitial;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-9">

            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-header bg-primary text-white p-4 rounded-top-4">
                    <h3 class="mb-1">My Profile</h3>
                    <p class="mb-0">
                        Manage your personal information and profile picture.
                    </p>
                </div>

                <div class="card-body p-4 p-md-5">

                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show">
                            @TempData["SuccessMessage"]
                            <button type="button" class="btn-close"
                                    data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show">
                            @TempData["ErrorMessage"]
                            <button type="button" class="btn-close"
                                    data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <div class="row align-items-center">

                        <div class="col-md-4 text-center mb-4">

                            <div class="profile-image-container mx-auto mb-3">

                                @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                                {
                                    
                                    <img id="profilePreview"
                                         src="@Model.ImageUrl"
                                         alt="Profile Image"
                                         class="profile-image" />
                                }
                                else
                                {
                                    <div id="profileInitials"
                                         class="profile-placeholder">
                                        @initials
                                    </div>

                                    <img id="profilePreview"
                                         src=""
                                         alt="Profile picture preview"
                                         class="profile-image d-none" />
                                }

                            </div>

                            <h5 class="mb-1">
                                @Model.FirstName @Model.LastName
                            </h5>

                            <small class="text-muted">
                                Profile Picture
                            </small>

                        </div>

                        <div class="col-md-8">

                            <h5 class="mb-3">Personal Information</h5>

                            <div class="mb-3">
                                <label class="form-label fw-semibold">
                                    First Name
                                </label>
                                <input class="form-control"
                                       value="@Model.FirstName"
                                       readonly />
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold">
                                    Last Name
                                </label>
                                <input class="form-control"
                                       value="@Model.LastName"
                                       readonly />
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold">
                                    Email Address
                                </label>
                                <input class="form-control"
                                       value="@Model.EmailAddress"
                                       readonly />
                            </div>

                        </div>
                    </div>

                    <hr class="my-4" />

                    <h5 class="mb-3">Update Profile Picture</h5>

                    <form asp-controller="Profile"
                          asp-action="UploadImage"
                          method="post"
                          enctype="multipart/form-data">

                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label asp-for="Image"
                                   class="form-label fw-semibold">
                                Choose a new picture
                            </label>

                            <input asp-for="Image"
                                   id="imageInput"
                                   type="file"
                                   class="form-control"
                                   accept=".jpg,.jpeg,.png,.webp" />

                            <span asp-validation-for="Image"
                                  class="text-danger"></span>

                            <small class="text-muted">
                                Supported formats: JPG, JPEG, PNG and WEBP.
                                Maximum file size: 5 MB.
                            </small>
                        </div>

                        <div class="d-flex flex-wrap gap-2">

                            <button type="submit"
                                    class="btn btn-primary px-4">
                                <i class="bi bi-cloud-upload me-2"></i>
                                Upload Picture
                            </button>

                            <button type="button"
                                    id="clearImage"
                                    class="btn btn-outline-secondary">
                                Clear Selection
                            </button>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

<style>
    .profile-image-container {
        width: 160px;
        height: 160px;
        border-radius: 50%;
        overflow: hidden;
        border: 4px solid #e9ecef;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .profile-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 50%;
    }

    .profile-placeholder {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 42px;
        font-weight: 600;
        color: white;
        background: #0d6efd;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const imageInput = document.getElementById("imageInput");
        const profilePreview = document.getElementById("profilePreview");
        const profileInitials = document.getElementById("profileInitials");
        const clearImage = document.getElementById("clearImage");

        let previewUrl = null;

        imageInput.addEventListener("change", function () {
            const file = this.files[0];

            if (!file) return;

            const allowedTypes = [
                "image/jpeg",
                "image/png",
                "image/webp"
            ];

            if (!allowedTypes.includes(file.type)) {
                alert("Please select a JPG, PNG or WEBP image.");
                this.value = "";
                return;
            }

            if (file.size > 5 * 1024 * 1024) {
                alert("The image must be 5 MB or smaller.");
                this.value = "";
                return;
            }

            if (previewUrl) {
                URL.revokeObjectURL(previewUrl);
            }

            previewUrl = URL.createObjectURL(file);

            profilePreview.src = previewUrl;
            profilePreview.classList.remove("d-none");

            if (profileInitials) {
                profileInitials.classList.add("d-none");
            }
        });

        clearImage.addEventListener("click", function () {
            imageInput.value = "";

            if (previewUrl) {
                URL.revokeObjectURL(previewUrl);
                previewUrl = null;
            }

            profilePreview.src = "";
            profilePreview.classList.add("d-none");

            if (profileInitials) {
                profileInitials.classList.remove("d-none");
            }
        });
    </script>
}
